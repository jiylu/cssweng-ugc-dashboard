model Contract_Submission_History {
  history_id     String               @id @default(uuid())
  contract_id    String
  action_status  ContractActionStatus
  revision_notes String?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
}

model Proposals {
  proposal_id     String         @id @default(uuid())
  public_id       String         @unique @db.VarChar(10)
  campaign_id     String
  client_email    String
  client_comments String         @default("")
  proposal_status ProposalStatus @default(PENDING)

  campaign Campaigns @relation(fields: [campaign_id], references: [campaign_id])
}

model Deliverables {
  deliverable_id String @id @default(uuid())
  public_id      String @unique @db.VarChar(10)
  campaign_id    String

  quantity            Int
  deliverable_type    DeliverableType
  deliverable_content String
  requirements        String
  due_date            DateTime
  post_date           DateTime
  pricing             Decimal

  campaign Campaigns @relation(fields: [campaign_id], references: [campaign_id])
}

model Submissions {
  submission_id     String @id @default(uuid())
  deliverable_id    String
  deliverable_index Int
}

model SubmissionItems {
  submission_item_id String           @id @default(uuid())
  submission_id      String
  public_id          String           @unique @db.VarChar(10)
  is_video           Boolean
  script_id          String?
  content            String
  submission_status  SubmissionStatus
  client_comments    String
  created_at         DateTime
  updated_at         DateTime
}

model AddOns {
  add_on_id   String  @id @default(uuid())
  campaign_id String
  public_id   String  @unique @db.VarChar(10)
  add_on_name String
  fee         Decimal
  initials    String
  opt_in      Boolean @default(false)
}

model Scripts {
  script_id         String           @id @default(uuid())
  public_id         String           @unique @db.VarChar(10)
  content           String
  client_comments   String
  submission_status SubmissionStatus
  created_at        DateTime
  updated_at        DateTime
}

model ActivityLog {
  log_id      String     @id @default(uuid())
  user_id     String
  entity_type EntityType
  entity_id   String
  action      Action
  created_at  DateTime

  user User @relation("ActivityLogUser", fields: [user_id], references: [user_id])
}

model Notifications {
  notification_id String   @id @default(uuid())
  user_id         String
  title           String
  message         String
  is_read         Boolean
  created_at      DateTime @default(now())
}

enum UserRoles {
  CLIENT
  CREATOR
}

enum DeliverableType {
  COLLABORATION
  UGC
}

enum CampaignStatus {
  ACTIVE
  REJECTED
  COMPLETED
}

enum CampaignCurrency {
  CAD
  USD
  PHP
  EUR
  GBP
}

enum ProposalStatus {
  PENDING
  FOR_REVISION
  REJECTED
  ACCEPTED
}

enum EntityType {
  CAMPAIGN
  SUBMISSION
  PAYMENT
}

enum Action {
  SUBMISSION
  APPROVE
  SIGNED
}

enum ContractActionStatus {
  DRAFT
  REVISION_REQUESTED
  CLIENT_SIGNED
  FULLY_SIGNED
}

enum SubmissionStatus {
  FOR_REVIEW
  FOR_REVISION
  APPROVED
}
